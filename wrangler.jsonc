{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berserk-engine-api",
  "main": "api/worker.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "BerserkEngineContainer",
      "image": "./api/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BERSERK_ENGINE",
        "class_name": "BerserkEngineContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BerserkEngineContainer"]
    }
  ]
}
